# Bu faylı .env kimi kopyalayın və dəyərləri doldurun. .env heç vaxt git-ə əlavə edilməməlidir.
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Ən azı 32 simvol, təsadüfi: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
DB_URL=
EMAIL_USER=
EMAIL_PASS=
# Render pulsuz planında SMTP bağlıdır: brevo.com açarı və orada təsdiqlənmiş göndərən ünvan
BREVO_API_KEY=
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# İstəyə görə: öz OSRM marşrut serveriniz
OSRM_URL=
